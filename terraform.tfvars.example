# ============================================================
# InfraGuidAI — Terraform Variables (EXAMPLE)
# ============================================================
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is GITIGNORED — never commit real values.
# ============================================================

# AWS Account & Region
aws_region     = "us-east-1"
aws_account_id = "YOUR_AWS_ACCOUNT_ID"

# Project
project     = "infraguidai"
environment = "prod"

# Domain (must match Route 53 hosted zone)
domain_name    = "yourdomain.com"
hosted_zone_id = "YOUR_HOSTED_ZONE_ID"

# EKS
eks_version        = "1.30"
node_instance_type = "t3.large"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 3

# ECR
ecr_namespace = "infragui"

# RDS
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20
rds_multi_az          = false

# Log Intelligence Agent
alert_email               = "admin@yourdomain.com"
bedrock_logintel_model_id = "amazon.nova-pro-v1:0"
enable_argocd_correlation = true
argocd_server_url         = "https://argocd.nutritrack360.in"
